# Plantilla de variables. Copia este archivo a .env y escribe TUS valores ahí:
#   cp .env.example .env
# .env nunca se sube a git. Este archivo (.env.example) NO lleva claves reales.

# Obligatoria: clave de Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY_LOCAL=

# Búsqueda web de plagas (app.tavily.com). Opcional: sin ella, AgroBot no busca en internet
TAVILY_API_KEY=

# Token del bot (@BotFather)
TELEGRAM_TOKEN=

# Números de chat autorizados, separados por coma (el bot te lo dice con /start)
TELEGRAM_PERMITIDOS=

# Opcionales: déjalas comentadas para usar los valores por defecto
# MODO=gemini
# GEMINI_MODEL=gemini-3.5-flash-lite
# API_TOKENS=
